set nocompatible
set encoding=utf-8

set noexpandtab
set tabstop=8
set softtabstop=0
set shiftwidth=8

set autoindent
set smartindent
set incsearch
set hlsearch

set mouse=a

syntax on
filetype plugin indent on

set number
set ruler
"set laststatus=2
set showcmd
set wildmenu
set wildmode=longest:full,full
set backspace=indent,eol,start
set hidden
set autoread
set scrolloff=3
set sidescrolloff=5

set ignorecase
set smartcase

nnoremap q <Nop>
vnoremap q <Nop>
nnoremap Q <Nop>
nnoremap Y y$

set timeoutlen=400
set ttimeoutlen=50

"colorscheme yuyuko
