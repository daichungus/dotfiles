[pull]
	rebase = true
[diff]
	algorithm = histogram
	context = 10
[transfer]
	fsckobjects = true
[fetch]
	fsckobjects = true
[receive]
	fsckObjects = true
[merge]
	conflictstyle = zdiff3
[core]
	filemode = false
	autocrlf = false
